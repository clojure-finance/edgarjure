{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.2"}

        ;; HTTP client
        hato/hato {:mvn/version "1.0.0"}

        ;; JSON
        metosin/jsonista {:mvn/version "0.3.8"}

        ;; HTML parsing
        hickory/hickory {:mvn/version "0.7.1"}

        ;; Rate limiting
        com.bucket4j/bucket4j-core {:mvn/version "8.10.1"}

        ;; Filesystem
        babashka/fs {:mvn/version "0.5.22"}

        ;; Data
        techascent/tech.ml.dataset {:mvn/version "8.024"}

        ;; Schema validation
        metosin/malli {:mvn/version "0.16.4"}}

 :aliases
 {:nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
   :main-opts ["-m" "nrepl.cmdline" "--port" "0"]
   :extra-paths ["test" "test-resources"]}

  :test
  {:extra-paths ["test" "test-resources"]
   :main-opts ["-m" "edgar.test-runner"]}

  :test-integration
  {:extra-paths ["test-integration"]
   :main-opts ["-m" "edgar.integration-test-runner"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}}
   :ns-default build}

  ;; Clerk notebook: clj -M:clerk then (clerk/serve! ...) — see examples/notebook.clj
  :clerk
  {:extra-deps {io.github.nextjournal/clerk {:mvn/version "0.17.1102"}}
   :extra-paths ["examples"]}}}
